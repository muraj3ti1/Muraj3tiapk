{
  "appId": "com.muraj3ti.murajaati",
  "appName": "مراجعتي",
  "webDir": "www",
  "backgroundColor": "#041029",
  "server": {
    "url": "https://muraj3ti1.github.io/Muraj3tiapp/",
    "allowNavigation": ["*.firebaseapp.com", "accounts.google.com"]
